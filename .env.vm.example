# Runtime configuration for the single-node cloud deployments.
#
# Shared by the OCI Ampere A1 and GCP e2-micro targets.
#
# Copy this file, fill in real values, and install it on the instance as
# /opt/python-tts/.env.runtime with mode 0600. The bootstrap script
# scripts/deploy/vm-bootstrap-env.sh does both steps for you.
#
# Never commit a filled-in copy. This example must contain placeholders only.
# These values are read by the bot container; they are not OpenTofu variables
# and must never appear in infrastructure state.

# --- Required secrets -------------------------------------------------------
# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Shared token required for POST /speak whenever the bot HTTP host is not
# loopback. The Desktop App sends it as the X-Bot-Token header.
# Generate a strong random value, for example: openssl rand -hex 32
BOT_SPEAK_TOKEN=

# --- Bot HTTP runtime -------------------------------------------------------
DISCORD_BOT_HOST=0.0.0.0
PORT=10000
LOG_LEVEL=INFO

# Leave empty unless a browser client is intentionally deployed. The Desktop
# App does not need CORS.
BOT_HTTP_CORS_ALLOWED_ORIGINS=

BOT_HTTP_MAX_BODY_BYTES=4096
BOT_RATE_LIMIT_MAX_REQUESTS=8
BOT_RATE_LIMIT_WINDOW_SECONDS=10

# --- TTS --------------------------------------------------------------------
TTS_ENGINE=gtts
TTS_LANGUAGE=pt
TTS_VOICE_ID=roa/pt-br
TTS_RATE=180
MAX_TEXT_LENGTH=500

# --- Lightweight runtime shape ----------------------------------------------
# JSON config storage instead of Postgres, and an in-process queue instead of
# Redis. This is what keeps a 1 OCPU / 6 GB instance viable. CONFIG_STORAGE_DIR
# is a bind mount, so configuration survives container recreation.
CONFIG_STORAGE_BACKEND=json
CONFIG_STORAGE_DIR=/app/configs

TTS_QUEUE_BACKEND=inmemory
TTS_QUEUE_MAX_SIZE=50

# The full observability stack is not deployed on this host.
OTEL_ENABLED=false

# --- Deployment identity ----------------------------------------------------
# Managed by scripts/deploy/vm-deploy.sh. APP_VERSION must be an immutable
# released tag such as v1.2.3, never "latest".
BOT_IMAGE=ghcr.io/erikalira/tts-hotkey-windows-bot
APP_VERSION=
PREVIOUS_APP_VERSION=

# --- Host sizing ------------------------------------------------------------
# Container memory ceiling. Keep the default on a 1 GB GCP e2-micro; raise it
# to something like 2g on the 6 GB OCI Ampere host.
BOT_MEMORY_LIMIT=768m

# --- Public HTTPS (only when enable_public_https = true) --------------------
# Must match the public_hostname given to OpenTofu and have a DNS A record
# pointing at the instance public IP.
PUBLIC_HOSTNAME=
# Optional ACME contact address for certificate expiry notices.
ACME_EMAIL=
