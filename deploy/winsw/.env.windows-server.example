# Windows Server example for running the Discord bot with WinSW.
# Copy this file to the repository root as .env on the server and fill in real values.

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Use 0.0.0.0 when the Desktop App or other clients need to reach the bot from another machine.
DISCORD_BOT_HOST=0.0.0.0
DISCORD_BOT_PORT=10000

# Optional: set this when the Windows service cannot find ffmpeg through PATH.
# Example: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Optional TTS overrides.
TTS_ENGINE=gtts
TTS_LANGUAGE=pt
TTS_VOICE_ID=roa/pt-br
TTS_RATE=180

# Optional HTTP request limit.
MAX_TEXT_LENGTH=500

# Fish Audio TTS provider. Required only when a guild/user selects the
# 'fish-audio' engine. Get a key at https://fish.audio/app/api-keys/
FISH_AUDIO=
# Model sent as the 'model' request header. The free model costs neither API
# credit nor platform quota, but is announced only through 2026-11-30; when it
# stops being served the API answers 402 and this value must change (omitting
# the header entirely falls back to the PAID default).
FISH_AUDIO_MODEL=s2.1-pro-free
